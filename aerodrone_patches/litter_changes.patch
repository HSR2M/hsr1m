+def _confidence(vol, gps_rms, sfm=None, scale_src=""):
+    """부피 신뢰 플래그: 물체 점 수 · 사용 뷰 수 · 바닥 평면 기울기 · 3D↔GPS 잔차
+    + (0015 결과로 보강) 마스크 부피와 높이지도 부피의 불일치 · SfM 등록률 · 희소 점 수.
+    0015에서 '높음'이었던 #6(+440 %: 마스크 85 L vs 높이지도 21 L)·#19(+73 %: 뷰 8·점 442)·#9(+35 %: 등록 23/40, 희소 1,077)는
